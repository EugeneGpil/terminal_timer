# display mode: plain | fancy | empty = auto-detect (fancy on a terminal >= 64 cols)
TIMER_MODE=

# host user/group the container runs as (must match your desktop session
# for audio and notifications to work); `id -u` / `id -g`
UID=1000
GID=1000

# Telegram notification when the timer finishes (optional — leave empty to disable).
# Token from @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
